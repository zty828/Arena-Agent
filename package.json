{
  "name": "arena-bridge",
  "version": "0.1.0-stage1",
  "private": true,
  "description": "ArenaBridge: an auditable local MCP workspace bridge. A remote model reaches this machine's files through a supervised, revocable, fully logged bridge instead of getting a shell.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "bin": {
    "arena-bridge": "dist/apps/daemon/src/cli.js"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-local-config.mjs",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json && node scripts/build-desktop.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test": "node --test --test-concurrency=1 dist/tests/*.test.js",
    "test:clean": "node scripts/run-tests-clean.mjs",
    "test:workspace:clean": "node scripts/run-tests-clean.mjs dist/tests/workspace.test.js",
    "verify": "node scripts/verify.mjs",
    "test:gateway": "node --test --test-concurrency=1 --test-timeout=20000 dist/tests/gateway.test.js dist/tests/gateway-http.test.js dist/tests/daemon-gateway.test.js",
    "test:workspace": "node --test --test-concurrency=1 --test-timeout=90000 dist/tests/workspace.test.js",
    "smoke": "node scripts/smoke-local.mjs",
    "local": "node scripts/bootstrap-local.mjs",
    "serve": "node scripts/run-with-credentials.mjs",
    "credentials": "node scripts/gen-credentials.mjs",
    "expose": "node scripts/bootstrap-local.mjs --expose",
    "arena": "node scripts/arena-oneclick.mjs",
    "arena:prompt": "node scripts/arena-prompt.mjs",
    "arena:rehearse": "node scripts/arena-flow-test.mjs",
    "net:diagnose": "node scripts/net-diagnose.mjs",
    "start": "node dist/apps/daemon/src/cli.js",
    "sbom": "node scripts/sbom.mjs",
    "demo": "node dist/tests/demo.js",
    "tunnel": "node scripts/tunnel.mjs",
    "tunnel:verify": "node scripts/tunnel-e2e.mjs",
    "tunnel:external": "node scripts/tunnel-external-check.mjs",
    "net:ipv4": "node scripts/ipv4-diagnose.mjs",
    "verify:run": "node scripts/verify-run.mjs",
    "workbuddy": "node scripts/register-workbuddy.mjs",
    "workbuddy:remove": "node scripts/register-workbuddy.mjs --remove",
    "mcp:local-check": "node scripts/local-mcp-diag.mjs",
    "verify:workbuddy": "node scripts/verify-workbuddy.mjs",
    "gateway:report": "node scripts/gateway-report.mjs",
    "cli:trust": "node scripts/trust-cli-folder.mjs",
    "console:preview": "node scripts/console-preview.mjs",
    "desktop": "node scripts/desktop.mjs",
    "desktop:selftest": "node scripts/desktop-selftest.mjs",
    "probe:view": "node scripts/probe-workspace-view.mjs",
    "probe:rebind": "node scripts/probe-workspace-rebind.mjs",
    "probe:switch": "node scripts/probe-switch-recovery.mjs",
    "probe:exposed": "node scripts/probe-exposed-listener.mjs",
    "probe:loopback": "node scripts/sandbox-client-loopback.mjs",
    "probe:lease": "node scripts/probe-stale-lease.mjs",
    "probe:pinned": "node scripts/probe-pinned-remote-port.mjs",
    "probe:click": "node scripts/probe-connect-click-path.mjs",
    "probe:imports": "node scripts/probe-import-paths.mjs",
    "probe:wiring": "node scripts/probe-desktop-tunnel-wiring.mjs",
    "probe:pairing": "node scripts/probe-pairing-approval.mjs",
    "probe:client": "node scripts/probe-client-envelope.mjs",
    "probe:access-mode": "node scripts/probe-access-mode.mjs",
    "probe:auto-approve": "node scripts/probe-auto-approve.mjs",
    "probe:grant-lifetime": "node scripts/probe-grant-lifetime.mjs",
    "probe:exec": "node scripts/probe-exec.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "diff": "9.0.0",
    "picomatch": "4.0.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/picomatch": "4.0.3",
    "typescript": "5.9.3"
  }
}
